# Copy this file to ".env" and edit the values.
# DB_ENGINE=mysql uses MySQL (as in the project synopsis). Use DB_ENGINE=sqlite to try the project without MySQL.
DB_ENGINE=mysql
DB_NAME=careertrack
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DEBUG=1
SECRET_KEY=change-this-in-production
